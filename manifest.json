{
  "manifest_version": 3,
  "name": "Snippet Deck",
  "version": "1.0.0",
  "description": "Save reusable text snippets and copy them with one click while filling out job application forms.",
  "permissions": ["storage", "sidePanel"],
  "action": {
    "default_title": "Open Snippet Deck"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
